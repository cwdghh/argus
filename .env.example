# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# These variables are also read from your shell/environment if not set here.

# API key for the model endpoint (create one at the DashScope console).
ARGUS_API_KEY=sk-your-key-here

# Base URL of an OpenAI-compatible chat completions endpoint.
# Default: Alibaba Cloud DashScope compatible mode.
ARGUS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model identifier understood by the endpoint.
ARGUS_MODEL=deepseek-v4-flash-0731

# Reliability bounds (defaults shown).
# ARGUS_REQUEST_TIMEOUT_MS=300000
# ARGUS_STREAM_IDLE_TIMEOUT_MS=60000
# ARGUS_MAX_RETRIES=2
# ARGUS_MAX_STEPS=100
# ARGUS_MAX_TOOL_RESULT_CHARS=50000
# ARGUS_COMPACT_AT=300000
# ARGUS_COMPACT_KEEP=8
# Keep only the newest N saved sessions on startup (0 keeps all; active session is never pruned)
# ARGUS_SESSION_KEEP=0

# Optional system prompt (defaults to a built-in coding-agent prompt).
# ARGUS_SYSTEM_PROMPT=You are a helpful coding agent.
