{
  "name": "argus-minimal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "argus": "src/main.mjs"
  },
  "description": "A minimal, dependency-free terminal coding partner.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "test": "node scripts/test.mjs",
    "eval:tools": "node --env-file-if-exists=.env eval/tool-choice.mjs",
    "eval:coding": "node --env-file-if-exists=.env eval/coding.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
